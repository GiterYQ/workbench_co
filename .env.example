# 服务地址
XYXH_WORKBENCH_HOST=127.0.0.1
XYXH_WORKBENCH_PORT=8787

# 私有数据目录。留空时使用仓库内 data/ 的空结构。
WORKBENCH_DATA_DIR=

# 可选：接入本地知识库和内容资产目录
WORKBENCH_OBSIDIAN_DIR=
WORKBENCH_CONTENT_ROOT=

# 默认关闭本地命令和外部采集。只有在私有环境中确认后才开启。
WORKBENCH_ENABLE_LOCAL_COMMANDS=false

# 飞书 OpenAPI。默认关闭，配置完整后再改为 true。
WORKBENCH_ENABLE_FEISHU=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=
FEISHU_WIKI_SPACE_ID=
FEISHU_API_BASE_URL=https://open.feishu.cn
